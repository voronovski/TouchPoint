    "Touch Point" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch Point"
          }
        }
      }
    },
    "Touch Point keeps working locally without an account or network. Your complete private snapshot is used for recovery on another device; it is not shared with other people." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch Point продолжает работать локально без аккаунта и сети. Полная приватная копия используется для восстановления на другом устройстве и не передаётся другим людям."
          }
        }
      }
    },
    "Touch Point uses on-device notifications for upcoming actions. It never sends the greeting for you." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch Point использует уведомления устройства для предстоящих действий. Приложение никогда не отправляет поздравление вместо вас."
          }
        }
      }

    "Touch Point keeps working locally without an account or network. Your complete private snapshot is used for recovery on another device; it is not shared with other people." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch Point keeps working locally without an account or network. Your complete private snapshot is used for recovery on another device; it is not shared with other people."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch Point продолжает работать локально без аккаунта и сети. Полная приватная копия используется для восстановления на другом устройстве и не передаётся другим людям."
          }
        }
      }
    },
    "Touch Point uses on-device notifications for upcoming actions. It never sends the greeting for you. You can change notification access in iOS Settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch Point uses on-device notifications for upcoming actions. It never sends the greeting for you. You can change notification access in iOS Settings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch Point использует уведомления на устройстве для напоминания о предстоящих действиях. Приложение никогда не отправляет поздравление от вашего имени. Настройки доступа к уведомлениям можно изменить в настройках iOS."
          }
        }
      }

          }
        }
      }
    },
    "You can keep using Touch Point with notifications off. Your planned greetings stay in your schedule, and you can open and complete them as usual." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can keep using Touch Point with notifications off. Your planned greetings stay in your schedule, and you can open and complete them as usual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете пользоваться Touch Point с выключенными уведомлениями. Запланированные поздравления остаются в расписании — их можно открывать и отмечать выполненными как обычно."
          }
        }
      }
    },

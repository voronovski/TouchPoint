          }
        }
      }
    },
    "You can adjust this context for the generated text. The event, person, and template are not changed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can adjust this context for the generated text. The event, person, and template are not changed."

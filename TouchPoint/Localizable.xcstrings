      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иконка и цвет помогают узнать этот шаблон во всей библиотеке."
          }
        }
      }
    },
    "The recovered file will replace the current in-memory data only after it passes validation and saves successfully." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найденный файл заменит текущие данные в памяти только после проверки и успешного сохранения."
          }
        }
      }
    },
    "Their templates are kept and moved to Ungrouped." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаблоны сохранятся и перейдут в раздел «Без коллекции»."
          }
        }
      }
    },
    "There are no greetings in the selected period." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В выбранном периоде нет поздравлений."

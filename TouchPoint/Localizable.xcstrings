    "Focus adjusts which relationships and priorities appear first. Your people, dates, templates, and plans stay unchanged." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus adjusts which relationships and priorities appear first. Your people, dates, templates, and plans stay unchanged."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фокус меняет порядок отношений и приоритетов. Люди, даты, шаблоны и планы не изменяются."
          }
        }
      }
    },

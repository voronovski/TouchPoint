    "All planned greetings for this person, including overdue greetings, will be deleted from the queue. Completed and skipped greetings will remain in history. Deleted greetings cannot be restored." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All planned greetings for this person, including overdue greetings, will be deleted from the queue. Completed and skipped greetings will remain in history. Deleted greetings cannot be restored."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все запланированные поздравления для этого человека, включая просроченные, будут удалены из очереди. Выполненные и пропущенные останутся в истории. Удалённые поздравления нельзя восстановить."
          }
        }
